# Copy to e2e/.env.e2e (git-ignored). Local E2E stack only: never your development stack or the deployed app.
E2E_BASE_URL=http://localhost:5174
E2E_API_URL=http://localhost:8001/api/v1
E2E_DB_PORT=55432
E2E_S3_PORT=59000

# Test accounts. The admin is created by the API's create_admin script; the other two are created by the suite.
E2E_ADMIN_USER=e2e-admin
E2E_ADMIN_PASS=E2e-admin-pass-1
E2E_ORGADMIN_USER=e2e-orgadmin
E2E_ORGADMIN_PASS=E2e-orgadmin-pass-1
E2E_ANNOTATOR_USER=e2e-annotator
E2E_ANNOTATOR_PASS=E2e-annotator-pass-1
